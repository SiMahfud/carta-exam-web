# ==============================================================================
# CartaExam Environment Configuration
# Copy this file to .env and customize for your school / server:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (sqlite | mysql | postgres)
# ------------------------------------------------------------------------------
# Default: SQLite (Zero-config, ideal for quick start & small/medium schools)
DB_TYPE=sqlite
DB_NAME=local.db

# --- Option B: MySQL / MariaDB (Recommended for 500+ concurrent students) ---
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=cartaexam
# DB_PASS=your_strong_password
# DB_NAME=carta_exam

# --- Option C: PostgreSQL ---
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=your_strong_password
# DB_NAME=carta_exam

# Optional: Single connection URI (overrides DB_HOST/PORT/USER/PASS/NAME)
# DATABASE_URL=mysql://user:pass@localhost:3306/carta_exam

# ------------------------------------------------------------------------------
# 2. Security & Session
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a strong random secret (>= 32 characters) for production!
# Example: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars-long

# Cookie Secure Flag:
# Leave unset for automatic detection (HTTPS online = true, LAN/localhost HTTP = false)
# COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 3. Public Application URL
# ------------------------------------------------------------------------------
# Use http://localhost:3333 for local dev, or your public HTTPS domain in production
APP_URL=http://localhost:3333
NEXT_PUBLIC_APP_URL=http://localhost:3333

# ------------------------------------------------------------------------------
# 4. AI Assistant (Optional - can also be configured in Admin -> Settings UI)
# ------------------------------------------------------------------------------
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. CartaExambro Auto-Update Overrides (Optional)
# ------------------------------------------------------------------------------
# EXAMBRO_FORCE_UPDATE=false
# EXAMBRO_MIN_VERSION_CODE=1

# ------------------------------------------------------------------------------
# 6. PortoCarta Master Hub SSO & Sync Integration (Optional)
# ------------------------------------------------------------------------------
# Leave empty if running CartaExam standalone (default for most schools)
# PORTOCARTA_URL=https://porto.yourschool.sch.id
# NEXT_PUBLIC_PORTOCARTA_URL=https://porto.yourschool.sch.id
# PORTOCARTA_API_KEY=

# ------------------------------------------------------------------------------
# 7. Sentry Error Tracking (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
